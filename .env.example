# 개발: npm run server + npm run dev. 브라우저 주소는 ADMIN_ORIGIN과 같아야 합니다.
ADMIN_ORIGIN=http://localhost:5173
PORT=3100
IDENTITY_URL=http://localhost:3004
ROUTINE_URL=http://localhost:3005
# 운영은 HTTPS ADMIN_ORIGIN 필수. 단일 인스턴스 메모리 세션: 재시작 시 재로그인.
# Google 계정 없이 identity의 관리자 아이디·비밀번호를 사용합니다.
# identity 서비스 최초 1회 환경 변수로 생성 후 bootstrap을 끄세요:
# ADMIN_BOOTSTRAP_ENABLED=true
# ADMIN_BOOTSTRAP_USERNAME=barofit-admin
# ADMIN_BOOTSTRAP_PASSWORD=<12~64자, UTF-8 72바이트 이하의 비밀번호를 Secret에서 주입>
# 비밀번호는 identity DB에 BCrypt 해시로만 저장되며 웹 서버에는 보관하지 않습니다.
